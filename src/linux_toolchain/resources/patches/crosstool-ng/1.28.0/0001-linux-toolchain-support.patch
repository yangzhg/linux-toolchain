new file mode 100644
index 0000000..c25fd6d
--- /dev/null
+++ b/packages/glibc/2.17/0071-BZ-16381-load-PIE-as-executable.patch
@@ -0,0 +1,95 @@
+From 332fe25c19aceda4a2d400f249fcf8ac345344af Mon Sep 17 00:00:00 2001
+From: Paul Pluzhnikov <ppluzhnikov@google.com>
+Date: Wed, 12 Mar 2014 15:58:39 -0700
+Subject: [PATCH] elf: load PIE main programs as executables [BZ #16381]
+
+Backport of upstream commit 798212a01311491d5e14fcda687460b75f8ca286 to glibc 2.17.
+
+Source: https://sourceware.org/pipermail/glibc-cvs/2014q1/056118.html
+
+The functional change is unchanged; Makefile context and the constructor-once regression test are adapted to the 2.17 test framework.
+---
+ elf/Makefile   |  5 +++--
+ elf/dl-load.c  |  4 ++--
+ elf/rtld.c     |  5 +++--
+ elf/tst-pie2.c | 38 ++++++++++++++++++++++++++++++++++++++
+ 4 files changed, 46 insertions(+), 6 deletions(-)
+ create mode 100644 elf/tst-pie2.c
+
+diff --git a/elf/Makefile b/elf/Makefile
+index 6c7bc97..e80648a 100644
+--- a/elf/Makefile
++++ b/elf/Makefile
+@@ -220,2 +220,2 @@ modules-names += tst-piemod1
+-tests += tst-pie1
+-tests-pie += tst-pie1
++tests += tst-pie1 tst-pie2
++tests-pie += tst-pie1 tst-pie2
+@@ -887 +887,2 @@ CFLAGS-tst-pie1.c += $(pie-ccflag)
+-CFLAGS-tst-pie1.c += $(pie-ccflag)
++CFLAGS-tst-pie1.c += $(pie-ccflag)
++CFLAGS-tst-pie2.c += $(pie-ccflag)
+diff --git a/elf/dl-load.c b/elf/dl-load.c
+index 70fe78f..41f478f 100644
+--- a/elf/dl-load.c
++++ b/elf/dl-load.c
+@@ -1527,2 +1527,2 @@ cannot enable executable stack as shared object requires");
+-  if (l->l_type == lt_library && type == ET_EXEC)
+-    l->l_type = lt_executable;
++  /* If this is ET_EXEC, we should have loaded it as lt_executable.  */
++  assert (type != ET_EXEC || l->l_type == lt_executable);
+diff --git a/elf/rtld.c b/elf/rtld.c
+index b0126e5..b755fa0 100644
+--- a/elf/rtld.c
++++ b/elf/rtld.c
+@@ -626 +626,2 @@ map_doit (void *a)
+-  args->map = _dl_map_object (args->loader, args->str, lt_library, 0,
++  int type = (args->mode == __RTLD_OPENEXEC) ? lt_executable : lt_library;
++  args->map = _dl_map_object (args->loader, args->str, type, 0,
+@@ -1078 +1079 @@ of this helper program; chances are you did not intend to run this program.\n\
+-	  _dl_map_object (NULL, rtld_progname, lt_library, 0,
++	  _dl_map_object (NULL, rtld_progname, lt_executable, 0,
+diff --git a/elf/tst-pie2.c b/elf/tst-pie2.c
+new file mode 100644
+index 0000000..5f715e5
+--- /dev/null
++++ b/elf/tst-pie2.c
+@@ -0,0 +1,38 @@
++/* Test case for BZ #16381
++
++   Copyright (C) 2014 Free Software Foundation, Inc.
++   This file is part of the GNU C Library.
++
++   The GNU C Library is free software; you can redistribute it and/or
++   modify it under the terms of the GNU Lesser General Public
++   License as published by the Free Software Foundation; either
++   version 2.1 of the License, or (at your option) any later version.
++
++   The GNU C Library is distributed in the hope that it will be useful,
++   but WITHOUT ANY WARRANTY; without even the implied warranty of
++   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
++   Lesser General Public License for more details.
++
++   You should have received a copy of the GNU Lesser General Public
++   License along with the GNU C Library; if not, see
++   <http://www.gnu.org/licenses/>.  */
++
++
++#include <assert.h>
++
++static int g;
++
++void init_g (void) __attribute__((constructor));
++
++void
++init_g (void)
++{
++  assert (g == 0);
++  g += 1;
++}
++
++int
++main (int argc, char *argv[])
++{
++  return 0;
++}
