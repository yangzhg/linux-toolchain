@@ -1575 +1575,2 @@ verbatim_data = \
-	packages/glibc/2.17/0070-x86_64-Correct-THREAD_SETMEM-THREAD_SETMEM_NC-for.patch \
+	packages/glibc/2.17/0070-x86_64-Correct-THREAD_SETMEM-THREAD_SETMEM_NC-for.patch \
+	packages/glibc/2.17/0071-BZ-16381-load-PIE-as-executable.patch \
@@ -1596 +1597,2 @@ verbatim_data = \
-	packages/glibc/2.19/0018-fix-GCC-10-detection.patch \
+	packages/glibc/2.19/0018-fix-GCC-10-detection.patch \
+	packages/glibc/2.19/0019-BZ-16381-load-PIE-as-executable.patch \
